# =========================================================
# QuickGo - .gitignore
# Regla de oro: aqui no entra nada que se pueda regenerar
# (bin, obj, node_modules) ni nada secreto (.env, claves).
# =========================================================

# ---------- Secretos y configuracion local ----------
# Se versionan SOLO los *.example (plantillas sin valores reales).
.env
.env.*
!.env.example
*.env.save
*.save
*.bak
*.orig
*.rej
secrets.json
appsettings.*.local.json
appsettings.Local.json
*.pem
*.key
*.pfx
*.p12
*.crt
*.snk
credentials*.json

# ---------- Sistema operativo ----------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini
$RECYCLE.BIN/

